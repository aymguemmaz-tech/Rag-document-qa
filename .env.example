# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- Providers (leave OPENAI_API_KEY empty to run fully offline) ---------------------------------
OPENAI_API_KEY=
RAGQA_LLM_MODEL=gpt-6-luna
RAGQA_LLM_REASONING_EFFORT=none
# RAGQA_LLM_TEMPERATURE=0          # omit for models that only accept their default
# RAGQA_LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (Ollama, vLLM)
RAGQA_EMBEDDER=auto                # auto | openai | wordllama | hashing
RAGQA_EMBEDDING_MODEL=text-embedding-3-small
RAGQA_GENERATOR=auto               # auto | llm | extractive

# --- Storage -------------------------------------------------------------------------------------
RAGQA_STORE=memory                 # memory (lite mode, persisted in RAGQA_DATA_DIR) | pgvector
RAGQA_DATABASE_URL=postgresql://ragqa:ragqa@localhost:5432/ragqa
RAGQA_DATA_DIR=.ragqa
RAGQA_COLLECTION=default
RAGQA_PIPELINE_CONFIG=configs/default.yaml

# --- API -----------------------------------------------------------------------------------------
# RAGQA_API_KEY=change-me          # require X-API-Key on /v1/* endpoints
RAGQA_LOG_JSON=false
